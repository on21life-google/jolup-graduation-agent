# Optional process environment names. The app does not load .env files automatically.
# A key-containing .env download is available only after an explicit UI request.
# Prefer the app's masked session-only API key input for a local demonstration.
# One common key field; known prefixes auto-select OpenAI or Anthropic.
JOLUP_API_KEY=
JOLUP_LLM_PROVIDER=auto
# Empty means the provider's preset. Advanced override, no automatic paid failover.
JOLUP_LLM_MODEL=
# Existing provider environment variables are also supported, if needed:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
